rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario (anónimo) solo puede ver y modificar sus propios discos.
    match /users/{userId}/albums/{albumId} {
      function esDueno() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Valida forma y valores de cada entrada (disco o canción) antes de guardarla.
      function albumValido(d) {
        return d.keys().hasOnly(['type', 'album', 'videoId', 'title', 'artist', 'year', 'coast', 'status', 'rating', 'tracks', 'createdAt', 'updatedAt'])
          && (!('type' in d) || d.type in ['album', 'cancion'])
          && (!('album' in d) || (d.album is string && d.album.size() <= 120))
          && (!('videoId' in d) || (d.videoId is string && d.videoId.size() <= 20))
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.artist is string && d.artist.size() > 0 && d.artist.size() <= 80
          && d.year is int && d.year >= 1980 && d.year <= 2016
          && d.coast in ['west', 'east', 'south', 'midwest']
          && d.status in ['pendiente', 'escuchando', 'escuchado']
          && d.rating is int && d.rating >= 0 && d.rating <= 5
          && d.tracks is list && d.tracks.size() <= 60;
      }

      allow read, delete: if esDueno();
      allow create, update: if esDueno() && albumValido(request.resource.data);
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
